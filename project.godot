; Engine configuration file.
; SNARE — first-person procedural horror, Godot 4.3+

config_version=5

[application]

config/name="SNARE"
config/description="Процедурный хоррор от первого лица: лабиринт, фонарик, шкафы и монстр."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.004, 0.005, 0.007, 1)
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/core/game_manager.gd"
AudioSynth="*res://scripts/core/audio_synthesizer.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
anti_aliasing/quality/msaa_3d=1

[physics]

common/physics_ticks_per_second=60
